# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=goodquestion

# asyncpg DSN (used by SQLAlchemy & Alembic)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/goodquestion

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────
# Supabase Auth
# Supabase 대시보드 → Settings → API 에서 확인
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ──────────────────────────────────────────────
# AWS S3
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2

# ──────────────────────────────────────────────
# OpenAI (STT 정규화, 장면 심판, 캐릭터 대사, 학습 리포트)
# ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60

# ──────────────────────────────────────────────
# Groq (Whisper STT)
# ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# ──────────────────────────────────────────────
# Anthropic (학습 리포트 분석, OpenAI 키가 없을 때 폴백)
# 비어 있으면 LLM 대신 스텁 분석기가 동작한다
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT_SECONDS=60

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://heijionline.com

# ──────────────────────────────────────────────
# Cloudflare Tunnel
# ──────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
