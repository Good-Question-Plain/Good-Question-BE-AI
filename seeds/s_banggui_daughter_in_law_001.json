    {
      "id": "5167ac7d-29e0-5c26-a27f-10ee5e2e24a0",
      "content_key": "sc_banggui_03",
      "scene_order": 3,
      "scene_type": "dialogue",
      "scene_description": "며느리가 큰 방귀를 가족에게 들킬까 봐 걱정하고 있다. 방귀는 누구나 뀌는 일이지만, 며느리에게는 큰 비밀처럼 느껴진다.",
      "conflict": "며느리가 방귀를 숨기고 가족에게 솔직하게 말하지 못한다.",
      "character_key": "ch_banggui_daughter_in_law",
      "character_name": "며느리",
      "character_opening": "ㅇㅇ아, 내 방귀가 너무 크다는 걸 알면 가족들이 나를 이상하게 생각하지 않을까?",
      "character_closing": "그래도 아직은 못 말하겠어. 조금만 더 참아 볼게.",
      "scene_goal": "방귀를 숨기고 싶어 하는 며느리의 입장을 이해하고, 공감해 주며 문제를 숨기지 않고 솔직하게 말할 수 있는 용기를 준다.",
      "required_elements": [
