    {
      "id": "6da81aec-a364-5008-a382-bb3bfa88b19e",
      "content_key": "sc_banggui_09",
      "scene_order": 9,
      "scene_type": "dialogue",
      "scene_description": "시아버지가 사과한 뒤, 며느리가 자신이 숨기고 싶었던 특징이 누군가에게 도움이 될 수 있다는 것을 알게 된다.",
      "conflict": "며느리가 자신의 다름을 아직 부끄러워할지 말지 망설인다.",
      "character_key": "ch_banggui_daughter_in_law",
